# Lattice - Environment Configuration
# Copy this file to .env and fill in your values.

# Built-in Free Tier keys
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: Add your API keys here to use BYOK models.
# If omitted, Lattice will attempt to use its limited built-in free tier.
VITE_OPENAI_API_KEY="your-openai-api-key-here"
VITE_ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Firebase Configuration (For Unified Agentic Memory)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
